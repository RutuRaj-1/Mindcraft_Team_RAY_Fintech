# FinFlow AI — Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Demo Mode (deterministic fallbacks enabled for zero-dependency hackathon testing)
DEMO_MODE=true

# Firebase Configuration (Optional if DEMO_MODE=true)
FIREBASE_PROJECT_ID=finflow-ai-demo
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_STORAGE_BUCKET=finflow-ai-demo.appspot.com

# LLM & OCR API Keys (Optional with built-in deterministic fallbacks)
GEMINI_API_KEY=
OPENAI_API_KEY=

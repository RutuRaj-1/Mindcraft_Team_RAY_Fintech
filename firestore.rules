rules_version = '2';

/**
 * FinFlow AI — Enterprise RBAC & Separation of Duties Security Rules
 * =================================================================
 * Architecture & Governance Principles:
 * - Direct client access strictly gated by 7+1 Role-Based Access Control (RBAC).
 * - Separation of Duties: System Admin has ZERO financial sanction or review authority.
 * - Customer data projection: Customers can view only their own case and public explanations.
 * - Evidence Ledger & Audit Trail: APPEND-ONLY and cryptographically immutable.
 * - Four-Eyes Principle: Multi-tier reviews require authorized institutional roles.
 * - No person or role (including SysAdmin) may delete or tamper with audit records.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. RBAC HELPER FUNCTIONS
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role extraction strictly from cryptographically verified claims (fallback to CUSTOMER)
    function getRole() {
      return request.auth.token.role != null ? request.auth.token.role : 'CUSTOMER';
    }

    function hasRole(role) {
      return isAuthenticated() && getRole() == role;
    }

    // --- Individual Role Testers (7 Business Roles + 1 Technical Custodian) ---
    function isCustomer()       { return hasRole('CUSTOMER'); }
    function isRM()             { return hasRole('RM'); }
    function isRiskOfficer()    { return hasRole('RISK_OFFICER'); }
    function isRMSupervisor()   { return hasRole('RM_SUPERVISOR'); }
    function isRiskManager()    { return hasRole('RISK_MANAGER'); }
    function isCreditApprover() { return hasRole('CREDIT_APPROVER'); }
    function isAuditOfficer()   { return hasRole('AUDIT_OFFICER'); }
    function isSysAdmin()       { return hasRole('SYS_ADMIN') || hasRole('ADMIN') || (request.auth.token.admin == true); }

    // --- Tiered Operational Groups ---
    // First-line operations: RM and RM Supervisor
    function isFirstLineOps() {
      return isRM() || isRMSupervisor();
    }

    // Second-line independent risk: Risk Officer and Risk Manager
    function isSecondLineRisk() {
      return isRiskOfficer() || isRiskManager();
    }

    // Sanction authority: Risk Manager (delegated limits) and Credit Approver / Committee
    function isSanctionAuthority() {
      return isRiskManager() || isCreditApprover();
    }

    // All financial institution personnel (excludes Customer and purely technical SysAdmin)
    function isInstitutionalStaff() {
      return isFirstLineOps() || isSecondLineRisk() || isSanctionAuthority() || isAuditOfficer();
    }

    // Application ownership validation
    function isApplicationOwner(applicationId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/applications/$(applicationId)) &&
        get(/databases/$(database)/documents/applications/$(applicationId)).data.userId == request.auth.uid
      );
    }

    function isJourneyOwner(journeyId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/journeys/$(journeyId)) &&
        get(/databases/$(database)/documents/journeys/$(journeyId)).data.applicant_id == request.auth.uid
      );
    }

    function notChanging(field) {
      return !(field in request.resource.data) ||
             (field in resource.data && request.resource.data[field] == resource.data[field]);
    }

    // =========================================================================
    // 2. USERS & PROFILES
    // =========================================================================
    match /users/{userId} {
      allow read: if isUser(userId) || isInstitutionalStaff() || isSysAdmin();
      // Public registration can only assign CUSTOMER role
      allow create: if isUser(userId) && (
        (request.resource.data.role == 'CUSTOMER') || isSysAdmin()
      );
      // Users can update their own profile fields, but only SysAdmin can change roles or delegated limits
      allow update: if (isUser(userId) && notChanging('role') && notChanging('userId') && notChanging('delegatedApprovalLimitInr')) || isSysAdmin();
      // User accounts are deactivated rather than deleted
      allow delete: if false;
    }

    // =========================================================================
    // 3. APPLICATIONS & JOURNEYS
    // =========================================================================
    match /applications/{applicationId} {
      allow read: if isApplicationOwner(applicationId) || isInstitutionalStaff();
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isFirstLineOps();
      allow update: if (isApplicationOwner(applicationId) && notChanging('applicationId') && notChanging('userId')) || isInstitutionalStaff();
      allow delete: if false; // Applications are legal artifacts; deletion is prohibited
    }

    match /journeys/{journeyId} {
      allow read: if isJourneyOwner(journeyId) || isInstitutionalStaff();
      allow create: if isAuthenticated() && (request.resource.data.applicant_id == request.auth.uid || isFirstLineOps());
      allow update: if isInstitutionalStaff() || (isAuthenticated() && resource.data.applicant_id == request.auth.uid && notChanging('journey_id'));
      allow delete: if false;
    }

    // =========================================================================
    // 4. DOCUMENTS & EVIDENCE ITEMS — EVIDENCE LEDGER IMMUTABILITY
    // =========================================================================
    match /documents/{documentId} {
      allow read: if isApplicationOwner(resource.data.applicationId) || isInstitutionalStaff();
      allow create: if isApplicationOwner(request.resource.data.applicationId) || isFirstLineOps();
      // Documents cannot have their fileHash or storagePath modified after upload
      allow update: if isInstitutionalStaff() && notChanging('fileHash') && notChanging('storagePath');
      allow delete: if false;
    }

    match /evidence_items/{evidenceId} {
      allow read: if isApplicationOwner(resource.data.applicationId) || isInstitutionalStaff();
      // Evidence items are created by OCR / backend extraction services
      allow create: if isInstitutionalStaff();
      // Extracted evidence items are immutable point-in-time facts
      allow update: if false;
      allow delete: if false;
    }

    // =========================================================================
    // 5. JOURNEY STEPS — STRICTLY APPEND-ONLY
    // =========================================================================
    match /journey_steps/{stepId} {
      allow read: if isApplicationOwner(resource.data.applicationId) || isInstitutionalStaff();
      allow create: if isAuthenticated() && (
        isApplicationOwner(request.resource.data.applicationId) || isInstitutionalStaff()
      );
      allow update: if false;
      allow delete: if false;
    }

    // =========================================================================
    // 6. RISK ASSESSMENTS & DECISIONS — IMMUTABLE SNAPSHOTS
    // =========================================================================
    match /risk_assessments/{riskId} {
      // Direct raw risk assessments with internal weights are institutional only
      allow read: if isInstitutionalStaff();
      allow create: if isSecondLineRisk() || isSanctionAuthority();
      allow update: if false;
      allow delete: if false;
    }

    match /decisions/{decisionId} {
      allow read: if isApplicationOwner(resource.data.applicationId) || isInstitutionalStaff();
      allow create: if isSanctionAuthority();
      allow update: if false; // Decisions are immutable once rendered
      allow delete: if false;
    }

    match /next_best_actions/{actionId} {
      allow read: if isApplicationOwner(resource.data.applicationId) || isInstitutionalStaff();
      allow create, update: if isInstitutionalStaff();
      allow delete: if false;
    }

    // =========================================================================
    // 7. AUDIT LOGS — STRICTLY APPEND-ONLY (TAMPER-PROOF LEDGER)
    // =========================================================================
    match /audit_logs/{auditId} {
      allow read: if isInstitutionalStaff() || (isAuthenticated() && resource.data.actorId == request.auth.uid);
      allow create: if isAuthenticated();
      // Absolute guarantee: Zero tolerance for editing or deleting audit logs
      allow update: if false;
      allow delete: if false;
    }

    // =========================================================================
    // 8. POLICIES & DELEGATED RULES
    // =========================================================================
    match /policy_documents/{policyId} {
      allow read: if isAuthenticated();
      // Policy changes require Senior Risk Manager or Credit Approver
      allow write: if isRiskManager() || isCreditApprover();
    }

    match /policy_chunks/{chunkId} {
      allow read: if isAuthenticated();
      allow write: if isRiskManager() || isCreditApprover();
    }

    match /delegated_authority_rules/{ruleId} {
      allow read: if isInstitutionalStaff();
      allow write: if isCreditApprover();
    }

    // =========================================================================
    // 9. FINANCIAL SNAPSHOTS — APPEND-ONLY
    // =========================================================================
    match /financial_snapshots/{snapshotId} {
      allow read: if isApplicationOwner(resource.data.applicationId) || isInstitutionalStaff();
      allow create: if isInstitutionalStaff() || isApplicationOwner(request.resource.data.applicationId);
      allow update: if false;
      allow delete: if false;
    }

    // =========================================================================
    // 10. FINANCIAL TRUST GRAPH & FRAUD SIGNALS
    // =========================================================================
    match /trust_graph_nodes/{nodeId} {
      allow read: if isInstitutionalStaff();
      allow write: if isSecondLineRisk();
    }

    match /trust_graph_edges/{edgeId} {
      allow read: if isInstitutionalStaff();
      allow write: if isSecondLineRisk();
    }

    match /fraud_signals/{signalId} {
      allow read: if isInstitutionalStaff();
      allow create: if isSecondLineRisk();
      allow update: if false;
      allow delete: if false;
    }

    // =========================================================================
    // 11. WHAT-IF SCENARIOS & SIMULATIONS
    // =========================================================================
    match /what_if_scenarios/{scenarioId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isInstitutionalStaff();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // =========================================================================
    // 12. HUMAN REVIEWS, SIGNING CHAINS & AUDIT FINDINGS
    // =========================================================================
    match /human_reviews/{reviewId} {
      allow read: if isInstitutionalStaff();
      allow create: if isInstitutionalStaff() && request.resource.data.reviewerId == request.auth.uid;
      allow update: if false; // Individual override events are immutable
      allow delete: if false;
    }

    match /application_reviews/{reviewId} {
      allow read: if isInstitutionalStaff();
      allow create: if isFirstLineOps() || isSecondLineRisk();
      allow update: if isInstitutionalStaff() && notChanging('aiBaseline') && notChanging('reviewId');
      allow delete: if false;
    }

    match /audit_findings/{findingId} {
      allow read: if isInstitutionalStaff();
      // Only Independent Audit Officer can create findings
      allow create: if isAuditOfficer() && request.resource.data.auditOfficerId == request.auth.uid;
      allow update: if isAuditOfficer() || isSanctionAuthority();
      allow delete: if false;
    }

    match /feedback_events/{feedbackId} {
      allow read: if isInstitutionalStaff();
      allow create: if isInstitutionalStaff();
      allow update: if false;
      allow delete: if false;
    }

    // =========================================================================
    // 13. NOTIFICATIONS & SYSTEM EVENTS
    // =========================================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt', 'updatedAt']);
      allow delete: if false;
    }

    match /system_events/{eventId} {
      allow read: if isSysAdmin() || isAuditOfficer();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

  }
}
